# =============================================================================
# DXN Stockpoint Enterprise — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values before running.

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL="postgresql://dxn_user:dxn_pass@localhost:5432/dxn_stockpoint?schema=public"

# ── Authentication ───────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ADMIN_PIN=2468
ADMIN_API_KEY=dxn_admin_key_change_in_production

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=8

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ── Real-time (Socket.io) ────────────────────────────────────────────────────
SOCKET_IO_CORS_ORIGIN=http://localhost:5173

# ── SteadFast Courier (optional) ─────────────────────────────────────────────
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key
